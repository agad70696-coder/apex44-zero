from typing import Dict, Any, List
from.cultural_context import EgyptianCulturalContext, SocialIntent
import re

class DeepSemanticAnalyzer:
    def __init__(self):
        self.cultural = EgyptianCulturalContext()

    def analyze(self, text: str, context: str = "") -> Dict[str, Any]:
        text=text.strip()
        cult = self.cultural.interpret(text)
        is_eg = any(w in text for w in ["فين","ابنى","جامد","مش","ده"])
        bias="none"; motive="unknown"
        if "6.0" in text or "ثوري" in text:
            bias="overconfidence_bias"; motive="status_seeking"
        elif "دليل" in text:
            bias="none"; motive="truth_seeking"
        elif text=="ابنى":
            motive="building"
        intent = cult.intent if cult else SocialIntent.BUILD_REQUEST
        social = cult.social_meaning if cult else f"عبارة: '{text}'"
        formal = cult.formal_logic if cult else f"Unknown('{text}')"
        return {"original_text": text, "is_egyptian": is_eg, "social_meaning": social, "intent": intent.value, "bias_detected": bias, "motive_inferred": motive, "formal_logic": formal, "deep_understanding": f"'{text}' → {social} → {formal}", "preserves_intent": True}

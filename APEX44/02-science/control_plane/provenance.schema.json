{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex44-zero/provenance-v0.1.schema.json",
  "title": "APEX44 Provenance Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "content_sha256",
    "source_ids",
    "dependency_ids",
    "transformation",
    "role",
    "independence_group",
    "status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "SOURCE",
        "DATA",
        "CODE",
        "PARAMETER",
        "MODEL",
        "ENVIRONMENT",
        "STATISTICAL",
        "INTERPRETIVE",
        "GOVERNANCE",
        "DERIVED"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "transformation": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "ANNOTATION",
        "DERIVATION",
        "INFERENCE",
        "GENERALIZATION",
        "COMPRESSION",
        "CONTROL"
      ]
    },
    "independence_group": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "CONFLICTED",
        "UNVERIFIED",
        "BLOCKED"
      ]
    }
  }
}
